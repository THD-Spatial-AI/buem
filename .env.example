# BUEM Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# python-dotenv loads .env automatically when buem starts.
# Variables already set in the OS environment are NEVER overridden.
#
# All path values can be absolute or relative to the project root.
# If a variable is left unset, BUEM falls back to sensible defaults
# relative to the installed package location (src/buem/).
# ──────────────────────────────────────────────────────────────────────────────

# Root of buem's own per-location weather cache (one feather file per
# distinct latitude/longitude/year/provider, generated from real
# `weather` package fetches -- see buem.config.weather_cache). No
# bundled/shipped weather data lives here anymore.
# Default (unset): <package_dir>/data/weather
# Docker default:  /app/data/weather  (set in docker-compose.yml)
#BUEM_WEATHER_DIR=src/buem/data/weather

# `weather` (https://github.com/UU-BUEM/weather) is a COMPULSORY
# dependency -- buem has no local/bundled weather data, so one of the
# two variables below must resolve to real processed provider archives
# (COSMO-REA6/ERA5-Land/MERRA-2 .nc output) or buem will fail to import.
#
# WEATHER_DATA_DIR: weather's OWN env var (not buem-prefixed) pointing at
# the root that contains all providers' <provider>/output/ subfolders --
# e.g. the weather repo's own data/ directory. This is the recommended
# way to configure it, since it works for whichever provider a given
# building requests without any buem-side per-provider logic.
#WEATHER_DATA_DIR=
#
# BUEM_WEATHER_DATA_DIR: passed to weather.get_point_weather() as an
# explicit data_dir override, replacing its per-provider subfolder lookup
# entirely -- only useful when every fetch buem makes uses the SAME
# single provider. Prefer WEATHER_DATA_DIR above otherwise.
#BUEM_WEATHER_DATA_DIR=

# Directory for simulation result output.
# Default (unset): <package_dir>/results
#BUEM_RESULTS_DIR=src/buem/results

# Directory for log files.
# Default (unset): <package_dir>/logs
#BUEM_LOG_DIR=src/buem/logs

# Path to the CBC solver binary used by PuLP / cvxpy.
# Default (unset): resolved from PATH at runtime.
# Conda (Linux):   /opt/conda/envs/buem_env/bin/cbc
# Conda (Windows): %CONDA_PREFIX%\Library\bin\cbc.exe
#BUEM_CBC_EXE=

# ──────────────────────────────────────────────────────────────────────────────
# WEATHER PIPELINE — now an independent repository
# ──────────────────────────────────────────────────────────────────────────────
# The COSMO-REA6/ERA5-Land/MERRA-2 download-and-processing pipeline (formerly
# `buem weather` and the COSMO_*/SLURM/Apptainer settings that configured it)
# has moved to its own repo: https://github.com/UU-BUEM/weather
# See that repo's own .env.example for its configuration variables.

# Conda environment name used by setup.ps1 / setup.bat as a fallback
# when 'buem' is not yet on PATH (i.e. before conda develop src).
# Default: buem_env
#BUEM_CONDA_ENV=buem_env

# API server bind address (used by `buem api` and Gunicorn).
# Default: 127.0.0.1 (loopback; use 0.0.0.0 in Docker)
#BUEM_API_HOST=127.0.0.1

# API server port.
# Default: 5000
#BUEM_API_PORT=5000
